---
import { getCollection } from "astro:content";
import DateComponent from "../components/FormattedDate.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import HCard from "../components/HCard.astro";

export const publishedPosts = (
		await getCollection('blog', ({ data }) => {
			const postDate = new Date(data.pubDate)
			return data.draft !== true && postDate <= new Date()
		})
	).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
---

<BaseLayout>
	<h1>Welcome!</h1>
	<HCard />
	<nav>
		<h2>Blog Posts</h2>
		<ul>
			{
				publishedPosts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`}>
							<DateComponent date={post.data.pubDate} /> - {post.data.title}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</BaseLayout>
