---
import { getCollection } from "astro:content";
import Head from "../components/Head.astro";
import DateComponent from "../components/FormattedDate.astro";

export const publishedPosts = (
		await getCollection('blog', ({ data }) => {
			const postDate = new Date(data.pubDate)
			return data.draft !== true && postDate <= new Date()
		})
	).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	);
---

<html lang="en">
	<head>
		 <Head />
	</head>
	<body>
		<h1>Andrea's Digital Garden</h1>
			<main>
				Welcome! Here are my blog posts.
				<ul>
					{
						publishedPosts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<DateComponent date={post.data.pubDate} /> - {post.data.title}
								</a>
							</li>
						))
					}
				</ul>
				You can also follow me on these sites.
				<ul>
  					<li><a href="https://github.com/anprivitera" rel="me">Github</a></li>
				</ul>
			</main>
	</body>
</html>
